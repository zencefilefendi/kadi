# Copy to .env and fill in. docker compose reads this file automatically.

# Bearer token required on /api/* and /metrics. Leave empty to disable auth (local use only).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
KADI_TOKEN=

# HMAC key Kadı uses to sign its data. Keep it stable across restarts.
KADI_SECRET=

# API key for the oracle provider. Set only the one(s) your kadi.toml uses.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional URL that receives event notifications.
KADI_WEBHOOK=
