{
  "name": "@kadi/client",
  "version": "0.1.0",
  "description": "Tiny dependency-free TypeScript client for the Kadı decision service",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc --noEmit -p .",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  }
}
